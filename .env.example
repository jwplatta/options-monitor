# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Tickrake data directory (default: ~/.tickrake)
TICKRAKE_HOME=

# MinIO intraday store
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=tickrake-intraday
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# AWS S3 archive
S3_BUCKET=
S3_REGION=us-east-1

# Docker port (default: 8502)
PORT=
